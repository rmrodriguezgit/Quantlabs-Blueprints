            "target": "Coordenada",
            "sourceHandle": "frame",
            "targetHandle": "frame",
            "animated": true
          },
          {
            "id": "Coordenada-Centrar",
            "source": "Coordenada",
            "target": "Centrar",
            "sourceHandle": "frame",

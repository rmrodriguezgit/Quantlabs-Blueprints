            },
            "data": {
              "kind": "model",
              "label": "Modelo",
              "params": {
                "architecture": "Transformer",
                "hidden": 32,
                "heads": 4,
                "layers": 1,
                "dropout": 0.1,
                "optimizer": "AdamW",
                "epochs": 12,
                "patience": 5,
                "lr": 0.001,
                "seed": 42
              }
            }
          },
          {
